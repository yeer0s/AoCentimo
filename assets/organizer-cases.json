{
  "_schema": {
    "version": "1.0.0",
    "income_year": 2025,
    "filed_year": 2026,
    "notes": "Modeling conventions for this golden corpus. Figures and annex letters are dated to income year 2025 (filed 2026) per SKILL.md's Domain playbook; re-verify before reusing for a different income year.",
    "status_vocabulary": {
      "deduction_inventory.document_status": [
        "Missing",
        "NotApplicable",
        "Present"
      ],
      "income_annex_map.status": [
        "Confirmed",
        "Estimated",
        "Missing"
      ]
    },
    "flag_codes": {
      "STOP_UNMAPPED": "Income item has no mapped Modelo 3 annex -- hard STOP, route to OCC review, never assign a best-guess annex.",
      "REJECT_INELIGIBLE": "Deduction claimed against a condition that structurally disqualifies it (e.g. mortgage interest on a post-2011 contract) -- must be marked NotApplicable, not Missing.",
      "FLAG_MISSING_AT_COMMUNICATION": "Displaced-student rent claimed without the AT 'Comunicacao de Renda' step completed -- must not be accepted as Present until that step is confirmed.",
      "FLAG_MUTUALLY_EXCLUSIVE": "Education (propinas) and pensao de alimentos both claimed for the same dependent -- these are mutually exclusive per dependent, must be flagged for the household to resolve, never both accepted.",
      "FLAG_WRONG_NIF": "A dependent's supporting invoice was issued under a non-custodial parent's NIF under shared custody -- cannot support this filer's claim as-is.",
      "FLAG_OCC_ROUTE": "Ex-NHR / IFICI ('NHR 2.0') election present -- this skill flags Anexo L and routes to an OCC, it never resolves eligibility itself.",
      "FLAG_BELOW_JUSTIFICATION_FLOOR": "Regime simplificado (Categoria B) taxpayer above the gross-income threshold with justified expenses under the 15% floor.",
      "FLAG_MISCATEGORIZED": "e-Fatura invoice sitting under the wrong category -- needs a portal correction, not silent acceptance."
    },
    "annex_letters": {
      "Rosto": "household identification, agregado composition, joint/separate election",
      "A": "Categoria A (employment) and Categoria H (pensions)",
      "B": "Categoria B, regime simplificado",
      "C": "Categoria B, contabilidade organizada",
      "E": "Categoria E, capital income (interest, dividends)",
      "F": "Categoria F, rental income",
      "G": "Categoria G, capital gains and other wealth increases",
      "H": "tax benefits and deductions",
      "J": "foreign-source income of any category",
      "L": "IFICI / ex-NHR special regime election",
      "UNMAPPED": "no current annex mapping exists -- hard STOP, route to OCC"
    },
    "income_type_to_annex_map": {
      "categoria_a": "A",
      "categoria_h": "A",
      "categoria_b_simplificado": "B",
      "categoria_b_organizada": "C",
      "categoria_e": "E",
      "categoria_f": "F",
      "categoria_g": "G",
      "categoria_j": "J",
      "ifici_pending": "L"
    }
  },
